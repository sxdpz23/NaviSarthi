{
  "name": "navisarthi-groups-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "migrate:firestore": "node dist/migrate-main.js",
    "test": "tsx --test tests/*.test.ts",
    "test:firebase": "tsx --test tests/firebase.integration.ts",
    "test:runtime": "npm run build && tsx --test tests/runtime.integration.ts",
    "typecheck": "tsc -p tsconfig.check.json"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.12.8",
    "firebase-admin": "^14.5.1",
    "livekit-server-sdk": "^2.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "ws": "^8.23.0"
  }
}
