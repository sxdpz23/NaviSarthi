# Local, volatile development. Never deploy STORE=memory.
STORE=memory
NODE_ENV=development
HOST=127.0.0.1
PORT=8080

# Generate a random 32-byte base64url secret; do not use this placeholder.
# MAINTENANCE_KEY=

# Production: use STORE=firebase, NODE_ENV=production, HOST=0.0.0.0.
# Application Default Credentials / Cloud Run service identity, never mobile app credentials.
# FIREBASE_PROJECT_ID=
# FIRESTORE_DATABASE_ID=groups
# Set only after confirming the target database edition.
# FIRESTORE_EDITION=standard
# FIREBASE_DATABASE_URL=https://YOUR-DEDICATED-INSTANCE.REGION.firebasedatabase.app
# GOOGLE_APPLICATION_CREDENTIALS=C:/private/service-account.json

# Optional audio: all three settings required together; no audio token is issued otherwise.
# LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
